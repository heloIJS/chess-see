{
  "manifest_version": 3,
  "name": "Chess-See",
  "version": "1.1.0",
  "minimum_chrome_version": "109",
  "description": "A local, see-through Stockfish HUD for Chess.com and Lichess. Arrows, ring, eval, and humanizer.",
  "permissions": ["storage", "offscreen"],
  "host_permissions": [
    "*://*.chess.com/*",
    "*://chess.com/*",
    "*://*.lichess.org/*",
    "*://lichess.org/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_title": "Chess-See",
    "default_popup": "src/popup/popup.html"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.chess.com/*",
        "*://chess.com/*",
        "*://*.lichess.org/*",
        "*://lichess.org/*"
      ],
      "js": [
        "src/lib/chess.min.js",
        "src/engine/uci-parser.js",
        "src/content/fen-builder.js",
        "src/content/board-adapter.js",
        "src/content/overlay.js",
        "src/content/hud.js",
        "src/engine/worker-bridge.js",
        "src/content/hotkeys.js",
        "src/content/main.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/shadow.css"
      ],
      "matches": [
        "*://*.chess.com/*",
        "*://chess.com/*",
        "*://*.lichess.org/*",
        "*://lichess.org/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'; connect-src 'self'"
  }
}
